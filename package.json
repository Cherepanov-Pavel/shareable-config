{
	"name": "@cherepanov.pavel/shareable-config",
	"description": "setup for new repositories",
	"version": "2.1.0",
	"type": "module",
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": "11.19.0"
		},
		"runtime": {
			"name": "node",
			"version": "26.7.0"
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Cherepanov-Pavel/shareable-config"
	},
	"files": [
		"modules/",
		"dist/"
	],
	"bin": {
		"setup": "./dist/setup.js",
		"update": "./dist/update.js",
		"get-all": "./dist/update.js",
		"set-env": "./dist/env.json5.set.js",
		"get-eslint": "./dist/eslint.config.ts-get.js",
		"get-stylelint": "./dist/stylelint.config.ts-get.js",
		"get-editorconfig": "./dist/.editorconfig-get.js",
		"get-gitattributes": "./dist/.gitattributes-get.js",
		"get-gitignore": "./dist/.gitignore-get.js",
		"get-extensions": "./dist/.vscode/extensions.json-get.js",
		"get-settings": "./dist/.vscode/settings.json-get.js",
		"get-code-snippets": "./dist/.vscode/code-snippets-get.js"
	},
	"exports": {
		"./eslint-config": {
			"import": "./dist/modules/eslint-config/index.js",
			"types": "./dist/modules/eslint-config/index.d.ts"
		},
		"./eslint-config/constants/*": {
			"import": "./dist/modules/eslint-config/constants/*.js",
			"types": "./dist/modules/eslint-config/constants/*.d.ts"
		},
		"./stylelint-config": {
			"import": "./dist/modules/stylelint-config/index.js",
			"types": "./dist/modules/stylelint-config/index.d.ts"
		},
		"./utils": {
			"import": "./dist/modules/utils/index.js",
			"types": "./dist/modules/utils/index.d.ts"
		}
	},
	"scripts": {
		"lint": "run-p -lc lint:js lint:css",
		"lint:fix": "run-p -lc lint:js:fix lint:css:fix",
		"lint:js": "eslint",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:css": "stylelint \"./**/*.{css,vue,astro}\" --ignore-path .gitignore --formatter verbose",
		"lint:css:fix": "npm run lint:css -- --fix",
		"prepack": "vite build",
		"vite-node": "vite-node --config vite.config.ts",
		"tarball": "npm run vite-node -- ./test/projects/create-lib-tarball.ts",
		"test-project": "npm run vite-node -- ./test/projects/create-astro-project.ts"
	},
	"dependencies": {
		"@clack/prompts": "1.8.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@stylistic/stylelint-plugin": "5.3.1",
		"@typescript-eslint/eslint-plugin": "8.71.2",
		"@typescript-eslint/parser": "8.71.2",
		"eslint": "10.12.0",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-vue": "10.11.1",
		"fs-extra": "11.4.1",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"json5": "2.2.3",
		"npm-run-all2": "9.0.3",
		"stylelint": "^17.16.0",
		"stylelint-config-html": "2.0.0",
		"stylelint-config-recess-order": "7.8.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-config-standard-vue": "2.0.0",
		"stylelint-order": "8.1.2",
		"vue-eslint-parser": "10.4.1"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^26.6.5",
		"rolldown-plugin-dts": "^0.28.8",
		"typescript": "^6.0.3",
		"unplugin-dts": "^1.1.2",
		"vite": "^8.3.4",
		"vite-node": "^6.0.0"
	}
}
