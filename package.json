{
	"name": "@cherepanov.pavel/shareable-config",
	"description": "setup for new repositories",
	"version": "1.0.16",
	"type": "module",
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": "12.0.2"
		},
		"runtime": {
			"name": "node",
			"version": "26.7.0"
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Cherepanov-Pavel/shareable-config"
	},
	"files": [
		"env.json5",
		"env.json5.set.js",
		".editorconfig",
		".editorconfig-get.js",
		".gitattributes",
		".gitattributes-get.js",
		".gitignore",
		".gitignore-get.js",
		".vscode/",
		"tools/",
		"utils/",
		"jsconfig.json"
	],
	"bin": {
		"set-env": "./env.json5.set.js",
		"get-all": "./.get-all.js",
		"get-editorconfig": "./.editorconfig-get.js",
		"get-gitattributes": "./.gitattributes-get.js",
		"get-gitignore": "./.gitignore-get.js",
		"get-extensions": "./.vscode/extensions.json-get.js",
		"get-settings": "./.vscode/settings.json-get.js",
		"get-code-snippets": "./.vscode/.code-snippets-get.js"
	},
	"scripts": {
		"lint": "run-p -lc lint:js lint:css",
		"lint:fix": "run-p -lc lint:js:fix lint:css:fix",
		"lint:js": "eslint",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:css": "stylelint \"./**/*.{css,vue}\" --ignore-path .gitignore --formatter verbose",
		"lint:css:fix": "npm run lint:css -- --fix"
	},
	"dependencies": {
		"@eslint/compat": "2.1.0",
		"@stylistic/eslint-plugin": "5.10.0",
		"@stylistic/stylelint-plugin": "5.2.1",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
		"@typescript-eslint/parser": "^8.66.0",
		"eslint": "^10.9.1",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-vue": "^10.10.0",
		"fs-extra": "^11.4.0",
		"globals": "^17.9.0",
		"jiti": "^2.7.0",
		"json5": "^2.2.3",
		"npm-run-all2": "^9.0.3",
		"postcss-html": "^2.0.0",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-config-standard-vue": "^2.0.0",
		"stylelint-order": "^8.1.1",
		"vue-eslint-parser": "^10.4.1"
	}
}
