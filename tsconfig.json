{
	"include": [
		"**/*.*s",
		"**/.*.ts",
		".*/**/*.ts",
		// ".gitignore-get.ts",
		// ".gitattributes-get.ts",
		// ".editorconfig-get.ts",
		// ".vscode/.code-snippets-get.ts",
		// ".vscode/extensions.json-get.ts",
		// ".vscode/settings.json-get.ts",
	],
	"compilerOptions": {
		"target": "esnext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": [
			"node",
		],
		"allowJs": true,
		"noEmit": true,
		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": [
				"./*",
			],
		},
	},
	"exclude": [
		"node_modules",
		"dist",
	],
}
