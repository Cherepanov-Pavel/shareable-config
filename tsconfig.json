{
	"include": [
		"**/*.*s",
		"**/.*.ts",
		".*/**/*.ts",
		// ".gitignore-get.ts",
		// ".gitattributes-get.ts",
		// ".editorconfig-get.ts",
		// ".vscode/.code-snippets-get.ts",
		// ".vscode/extensions.json-get.ts",
		// ".vscode/settings.json-get.ts",
	],
	"compilerOptions": {
		"target": "esnext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		// Even files without `import` or `export` are treated as modules.
		// It helps to avoid mysterious errors such as `Cannot redeclare block-scoped variable 'name`.
		// https://www.totaltypescript.com/cannot-redeclare-block-scoped-variable#solution-3-your-module-isnt-a-module
		"moduleDetection": "force",
		"noEmit": true,
		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": [
				"./*",
			],
		},
	},
	"exclude": [
		"node_modules",
		"dist",
	],
}
